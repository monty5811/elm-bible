{
  "name": "elm-bible",
  "version": "2.0.2",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "elm-test": "0.19.2-0",
    "elm-tooling": "1.19.0"
  },
  "scripts": {
    "postinstall": "elm-tooling install",
    "test": "elm-test --fuzz 10000",
    "format": "elm-format --yes src tests",
    "format:check": "elm-format --validate src tests",
    "docs": "elm make --docs=docs.json",
    "diff": "elm diff",
    "watch": "find . -name '*.elm' -not -path './elm-stuff/*' | entr -c elm make src/Bible.elm --output /dev/null",
    "watch-test": "find . -name '*.elm' -not -path './elm-stuff/*' | entr -c elm-test --fuzz 1000"
  }
}
